# ─────────────────────────────────────────────────────────────────────────────
# Appli Analyste — À COPIER EN « analyste/.env » puis à compléter À LA MAIN :
#   cp analyste/.env.example analyste/.env
# Lu par docker compose ET par analyste_site/settings.py. Jamais commité
# (.gitignore racine). ⚠️ Ce modèle ne porte AUCUNE valeur secrète : un test
# (test_squelette) échoue si une ligne sensible en reçoit une ici.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ──
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 1 en développement seulement (runserver). 0 sous docker compose.
DEBUG=0
ALLOWED_HOSTS=127.0.0.1,localhost
# Essai local sous docker compose, en http://127.0.0.1:8010 : mettre 0.
# Derrière un vrai HTTPS (plus tard, serveur à choisir) : 1.
USE_HTTPS=0
# CSRF_TRUSTED_ORIGINS=
# Nombre de proxys de confiance devant l'appli. 0 (défaut) : seule l'adresse
# de connexion (REMOTE_ADDR) compte, X-Forwarded-For est ignoré. À poser à 1
# UNIQUEMENT derrière un vrai proxy (nginx…) qui écrit lui-même cet en-tête.
# AXES_PROXY_COUNT=0

# ── Base MySQL (la SIENNE, jamais celle de Recrutement ni de Performance) ──
DB_ENGINE=mysql
DB_NAME=analyste
DB_USER=analyste
DB_PASSWORD=
# 127.0.0.1 hors Docker ; docker compose impose « db » (cf. docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=3306
# Lus par le conteneur MySQL de docker compose à sa PREMIÈRE création :
# MYSQL_USER n'a de droits que sur MYSQL_DATABASE (pas de GRANT global).
# Mettre la même valeur dans MYSQL_PASSWORD et DB_PASSWORD.
MYSQL_DATABASE=analyste
MYSQL_USER=analyste
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── StatsBomb (deux comptes, comme Recrutement) ──
# Le compte se choisira d'après le catalogue /v4/competitions de chacun (étape 2).
STATSBOMB_EMAIL=
STATSBOMB_PASSWORD=
STATSBOMB_EMAIL_2=
STATSBOMB_PASSWORD_2=

# ── Second Spectrum (accès du RC Lens, étape 4) ──
# Soit les identifiants client-credentials…
SECOND_SPECTRUM_CLIENT_ID=
SECOND_SPECTRUM_CLIENT_SECRET=
# …soit le chemin d'un fichier contenant le jeton (hors dépôt).
SS_TOKEN_FILE=
